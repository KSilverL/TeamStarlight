# ── Feature toggle ────────────────────────────────────────────────────────────
# Master switch. true = mock everywhere (default, no real API calls).
# One-click production: set USE_MOCK=false and provide the credentials below.
USE_MOCK=true

# Optional per-service overrides for gradual rollout. Leave unset to inherit
# USE_MOCK. Resolution order: per-service var > USE_MOCK > default(true).
#   USE_MOCK_LLM     dispatcher / scout / creator (Azure OpenAI / Foundry chat)
#   USE_MOCK_SAFETY  reviewer content-safety screen (Azure AI Content Safety)
#   USE_MOCK_STORE   brand profiles + workflow checkpoints (PostgreSQL)
#   USE_MOCK_VOICE   voice intake transport (Voice Live API)
#   USE_MOCK_IMAGE_SEARCH        collage/hook slide stock photos (Pexels)
#   USE_MOCK_BACKGROUND_REMOVAL  cut-out compositing (Remove.bg)
#   USE_MOCK_WEB_SEARCH          web research / review mining / live image search (Foundry Bing grounding)
# Example — run LLM for real but keep everything else on mock:
# USE_MOCK=true
# USE_MOCK_LLM=false
USE_MOCK_LLM=
USE_MOCK_SAFETY=
USE_MOCK_STORE=
USE_MOCK_VOICE=
USE_MOCK_IMAGE_SEARCH=
USE_MOCK_BACKGROUND_REMOVAL=
USE_MOCK_WEB_SEARCH=

# ── Azure OpenAI / Foundry (chat + structured output + copywriting) ────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
FOUNDRY_PROJECT_ENDPOINT=

# ── Roundtable model tiers (multi-persona discussion) ─────────────────────────
# ROUNDTABLE_ENABLED swaps scout for the multi-persona discussion. The LLM manager
# (plans / selects speakers / converges) stays on the main AZURE_OPENAI_CHAT_DEPLOYMENT;
# the personas run on a cheaper, rate-limit-friendlier model so N-personas × rounds chatter
# doesn't 429 the main quota. Each persona turn is a short, single-point contribution (like a
# real meeting), so the round cap is higher; the manager checks for a raised hand between turns.
ROUNDTABLE_ENABLED=false
ROUNDTABLE_MAX_ROUNDS=12
ROUNDTABLE_PERSONA_MAX_TOKENS=1024        # gpt-5.x: keep >=512, else hidden reasoning eats the whole
                                          # budget and turns come back EMPTY (finish_reason=length)
ROUNDTABLE_PERSONA_REASONING_EFFORT=minimal  # gpt-5.x reasoning models: "minimal" → reasoning_tokens=0
                                          # (needs the >=512 cap above). Blank if persona is non-reasoning.
ROUNDTABLE_PERSONA_VERBOSITY=low          # gpt-5.x: "low" → one short spoken point per turn (faster).
                                          # Blank if persona is a non-gpt-5 model.
ROUNDTABLE_MANAGER_MODEL=gpt-5.4      # blank → falls back to AZURE_OPENAI_CHAT_DEPLOYMENT
ROUNDTABLE_MANAGER_REASONING_EFFORT=low   # blank → "low" (project default): speeds the manager's
                                          # silent plan phase before the first turn + every
                                          # between-turn ledger call. Set minimal/medium/high to override.
ROUNDTABLE_PERSONA_MODEL=gpt-5-mini      # recommended: high limits, low cost, capable
# Personas may live on a SEPARATE Azure resource (own endpoint + key, OpenAI v1 form). Leave
# blank to reuse the main resource above and only switch the deployment name.
AZURE_PERSONA_ENDPOINT=
AZURE_PERSONA_API_KEY=
# Step mode (per-request `roundtable_mode: "manual"`): how long each round's 4-way prompt
# (next / speak / enough / auto) waits for POST /tasks/{id}/round-control before that table
# goes hands-off (sticky auto). Default mode is "auto" — no prompts unless the caller asks.
ROUNDTABLE_CONTROL_TIMEOUT=300

# ── Trend scout (fifth roundtable seat + the trend spread) ────────────────────
# TREND_SCOUT_ENABLED adds a `trend_scout` persona to every table, fed from the daily
# trends snapshot an EXTERNAL Foundry routine writes to the store's `trends` table
# (docs/TREND_SCOUT_IMPLEMENTATION.md). The SAME toggle also feeds the linear
# strategist's plan_strategy prompt and intake's suggest_topic copilot tool (Phase 4),
# so ordinary non-roundtable runs ride the daily data too. Every read degrades to
# "(no current trends available)" on any failure — an enhancement, never a dependency.
TREND_SCOUT_ENABLED=true
TREND_SCOUT_LIMIT=6                       # trends injected per run, picked category-diverse
TREND_SCOUT_TTL_DAYS=3                    # drop trends older than this when expires_at is unset

# ── Voice Live API (voice intake) ─────────────────────────────────────────────
AZURE_VOICELIVE_ENDPOINT=            # wss://<resource>.services.ai.azure.com/voice-live/realtime
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_API_VERSION=2026-04-10
AZURE_VOICELIVE_API_KEY=             # optional; falls back to AZURE_OPENAI_API_KEY (same resource)
AZURE_VOICELIVE_VOICE=verse          # preset voice for the realtime speech-to-speech bridge

# ── PostgreSQL (brand profiles + user skills + workflow checkpoints) ──────────
# Required when USE_MOCK_STORE=false. One database, three tables (auto-created;
# manual DDL also in migrations/001_user_skills.sql for the Supabase SQL editor).
# DATABASE_URL (preferred) wins over POSTGRES_DSN. Put the real password ONLY in
# your local .env (already gitignored) — never commit it.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hmddxzwbcvnmtqzhenux.supabase.co:5432/postgres
# NOTE: Supabase direct :5432 may resolve to IPv6 only; if you can't connect, use the
# connection pooler host instead, e.g.
#   postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-<region>.pooler.supabase.com:6543/postgres
POSTGRES_DSN=                        # postgresql://user:pass@host:5432/newsroom  (fallback if DATABASE_URL unset)
POSTGRES_PROFILES_TABLE=brand_profiles
POSTGRES_USER_SKILLS_TABLE=user_skills
POSTGRES_CHECKPOINTS_TABLE=workflow_checkpoints
# libpq sslmode. Leave blank for Supabase. Azure Cosmos DB for PostgreSQL REQUIRES
# SSL, so set this to `require` (or verify-full) when pointing DATABASE_URL there.
POSTGRES_SSLMODE=
# ── Azure Cosmos DB for PostgreSQL (Citus, wire-compatible) ───────────────────
# Drop-in Postgres backend. To migrate, point DATABASE_URL at the cluster and set
# POSTGRES_SSLMODE=require, e.g. (default user/db are `citus`):
#   DATABASE_URL=postgresql://citus:<password>@c-<cluster>.<id>.postgres.cosmos.azure.com:5432/citus
#   POSTGRES_SSLMODE=require
# Then copy existing rows with migrations/migrate_to_cosmos.py (see its header).
POSTGRES_VIDEO_JOBS_TABLE=video_jobs
POSTGRES_POSTING_PLANS_TABLE=posting_plans

# ── Azure AI Content Safety (reviewer) ────────────────────────────────────────
AZURE_CONTENTSAFETY_ENDPOINT=
AZURE_CONTENTSAFETY_KEY=

# ── Video storyboard pipeline (Pexels + Remove.bg + local Remotion render) ────
# Required when USE_MOCK_IMAGE_SEARCH=false / USE_MOCK_BACKGROUND_REMOVAL=false.
PEXELS_API_KEY=
REMOVEBG_API_KEY=
# Static-map basemaps for `map` slides (maps.geoapify.com). Optional — without a
# key, map slides render the bundled vector country outline instead.
GEOAPIFY_API_KEY=
# Background music. Set USE_MOCK_MUSIC_GENERATION=false to use REAL music instead of the
# silent mock. The default real provider is a local royalty-free library (no key, offline):
# add tracks under LLM_service/assets/music/ and tag them in manifest.json — see that
# folder's README.md. MUSIC_LIBRARY_DIR overrides where the tracks live. SOUNDRAW_API_KEY
# is only used as a fallback if no library is populated (Soundraw's API is enterprise-gated).
USE_MOCK_MUSIC_GENERATION=
MUSIC_LIBRARY_DIR=
SOUNDRAW_API_KEY=
# Path to the video_renderer/ Node project. Defaults to the repo-root sibling of
# LLM_service/ if unset — only needed when the layout differs (e.g. in Docker).
VIDEO_RENDERER_DIR=
# Per-job working directory (resolved images + the rendered MP4, local backend
# only). Relative paths resolve under LLM_service/; not git-tracked.
VIDEO_JOBS_DIR=.video_jobs
# Cross-slide attempt budget for one render job's WHOLE `generated`-slide codegen
# pass (workflow/video/codegen.CodegenBudget) — bounds total LLM calls + compiles +
# preview-renders across every bespoke slide in one storyboard, not just per-slide.
CODEGEN_MAX_TOTAL_ATTEMPTS=9
# The wall-clock half of that same budget, in seconds. Attempts bound COST; this
# bounds DURATION, which they don't: on a reasoning deployment a single attempt can
# run minutes, and nothing else caps the pass (jobs.py runs the render detached and
# the client just polls). Like the attempt budget it's a FLOOR, scaled up per bespoke
# slide, and it's only checked BETWEEN attempts — so the real bound is this plus one
# in-flight attempt. 0 disables it and restores attempt-only bounding.
CODEGEN_MAX_TOTAL_SECONDS=900
# Deployment + tuning for the scene-codegen LLM calls (generate_scene_component /
# plan_scene_design / review_scene_preview / convert_generated_to_template).
# CODEGEN_MODEL blank -> falls back to AZURE_OPENAI_CHAT_DEPLOYMENT; set it once a
# separate/stronger (e.g. coding-tuned) deployment is provisioned, same pattern as
# ROUNDTABLE_PERSONA_MODEL above.
CODEGEN_MODEL=
# gpt-5.x/o-series reasoning effort for the actual code-writing call. Blank -> model
# default. Codegen IS correctness-critical, but it is not latency-free either: this
# is the single biggest contributor to a render's wall clock, and it runs once per
# attempt per bespoke slide. Higher effort only pays for itself if it removes
# retries, so treat it as a measured trade, not a "more is better" dial —
# codegen.py logs `generate_s`/`attempt_s` per attempt precisely so you can compare
# effort levels on real storyboards instead of guessing.
CODEGEN_REASONING_EFFORT=low
# generate_scene_component's max_completion_tokens. MUST have headroom for hidden
# reasoning tokens (gpt-5.x/o-series) PLUS a full compiling TSX component — the
# same "keep it well above the reasoning floor" gotcha as ROUNDTABLE_PERSONA_MAX_TOKENS
# above (too low -> reasoning eats the whole budget, response comes back EMPTY /
# truncated, finish_reason=length).
CODEGEN_MAX_TOKENS=12000
# plan_scene_design's max_completion_tokens (the pre-code visual-concept call).
CODEGEN_PLAN_MAX_TOKENS=1536
# plan_scene_design is a short creative brainstorm, not deep reasoning — "minimal"
# (like the roundtable personas) keeps the budget on the visible bullets.
CODEGEN_PLAN_REASONING_EFFORT=minimal
# SDK-level retries for the codegen calls ONLY (everything else keeps 3). Keep at 0:
# the openai SDK retries APITimeoutError, so at the client's 300s timeout ONE long
# reasoning call costs 4 x 300s = 20 minutes before it raises. codegen.py's own loop
# is the right place to retry — it re-prompts with the error and re-validates.
CODEGEN_MAX_RETRIES=0
# review_scene_preview's max_completion_tokens (visual QA). A runaway ceiling, NOT a
# tight budget: no reasoning_effort is steered on this call, so it must stay well
# clear of the hidden-reasoning floor or the review returns EMPTY.
CODEGEN_REVIEW_MAX_TOKENS=4096
# convert_generated_to_template's max_completion_tokens + reasoning effort — the
# last-resort "turn this bespoke slide into a fixed template" call. Its prompt
# carries the whole ~23KB slide-type JSON schema, but the task is schema-filling,
# so "minimal" keeps the budget on the visible JSON. Blank effort -> the call sends
# temperature=0.2 instead (see AzureLLM._complete).
CODEGEN_CONVERT_MAX_TOKENS=4096
CODEGEN_CONVERT_REASONING_EFFORT=minimal

# ── Voiceover (Azure Speech text-to-speech, workflow/video/voiceover.py) ──────
# Required when USE_MOCK_VOICEOVER=false. Narration is on by default and agent-authored
# per slide; a render can override the script/voice or suppress it. Mock mode returns a
# real (silent) placeholder track sized from each line's word count.
# VOICEOVER_DEFAULT_VOICE defaults to an Azure Dragon HD voice (much more natural than
# the older Neural voices). NOTE: Dragon HD voices may require the S0 pricing tier (not
# the F0 free tier) and are only in some regions — verify your resource supports the
# voice, or set a standard Neural voice (e.g. en-US-JennyNeural) here instead.
USE_MOCK_VOICEOVER=
ROUNDTABLE_TTS_KEY=
ROUNDTABLE_TTS_REGION=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
VOICEOVER_DEFAULT_VOICE=en-US-Ava:DragonHDLatestNeural

# ── Remotion Lambda (cloud render backend, workflow/video/lambda_render.py) ───
# VIDEO_RENDER_BACKEND=local (default) keeps the original npx subprocess above.
# Set to "lambda" to render on AWS instead — output lands in S3, never on local
# disk, and GET /video-jobs/{id}/download 307-redirects to it. This service only
# ever TRIGGERS renders; deploy the function/site yourself first from
# video_renderer/ with the Remotion Lambda CLI:
#   npx remotion lambda functions deploy
#   npx remotion lambda sites create src/index.tsx --site-name=stable
# AWS credentials are resolved the standard way (env vars / shared config / IAM
# role) by the AWS SDK the Node trigger scripts use — nothing AWS-specific beyond
# the region is read from this file.
VIDEO_RENDER_BACKEND=local
AWS_REGION=
REMOTION_LAMBDA_FUNCTION_NAME=
# The stable, pre-deployed site's serve URL (from `sites create` above) — used for
# any storyboard with no bespoke `generated` slides. A storyboard WITH one deploys
# its own job-scoped ephemeral site instead (no action needed here for that case).
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_SITE_NAME_PREFIX=storyboard-job
# Optional: force a specific output bucket. Unset -> Remotion Lambda's own
# auto-managed per-region bucket.
REMOTION_LAMBDA_OUTPUT_BUCKET=

# ── Higgsfield (premium generative-AI-video backend, workflow/video/higgsfield_render.py) ─
# Set VIDEO_RENDER_BACKEND=higgsfield to route renders here instead of Remotion:
# one cinematic clip generated from a crafted prompt (+ optional user reference
# images attached in chat, for image-to-video). This is the intended fee-paying-tier
# product; the free tier stays on VIDEO_RENDER_BACKEND=local/lambda. Required when
# USE_MOCK_VIDEO_GENERATION=false; mock mode returns a real placeholder MP4 offline.
# Uses the official REST API (server-to-server, key auth) — NOT the MCP server, which
# is OAuth/agent-oriented and best kept as a dev-time prototyping tool only.
USE_MOCK_VIDEO_GENERATION=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Model ids: image-to-video (when reference images are attached) vs text-to-video.
# These must be the FULL catalog paths the SDK POSTs to platform.higgsfield.ai/<id>
# — a bare id like `dop` resolves to a legacy application whose schema requires
# `input_images` and rejects the documented `{image_url, prompt, duration}` body.
# See https://docs.higgsfield.ai/docs/guides/video.md for the current catalog paths.
HIGGSFIELD_IMAGE_MODEL=higgsfield-ai/dop/standard
# Text-to-video (no reference images): no confirmed catalog id in the docs — set this
# from your cloud.higgsfield.ai dashboard. Left blank, the no-reference path errors
# clearly instead of hitting a wrong endpoint; image-to-video above still works.
HIGGSFIELD_TEXT_MODEL=
# Clip length ceiling (seconds); clamped to the model's per-generation max (~15s).
HIGGSFIELD_MAX_DURATION_S=15

# ── Web research (Bing grounding via Azure AI Foundry agents) ────────────────
# Required when USE_MOCK_WEB_SEARCH=false. Reuses the FOUNDRY_PROJECT_ENDPOINT
# above; provision each agent the same way trend_scout_routine/README.md describes
# for the trend agent (portal instructions + the web grounding tool, published as a
# version). WEB_SEARCH_AGENT_NAME backs both general search_web/fetch_url_text and
# the live-image-search tool; REVIEW_SEARCH_AGENT_NAME backs search_reviews only.
WEB_SEARCH_AGENT_NAME=
WEB_SEARCH_AGENT_VERSION=
REVIEW_SEARCH_AGENT_NAME=
REVIEW_SEARCH_AGENT_VERSION=

# ── HTTP API server (LLM_service.api) — backend integration ─────────
API_HOST=0.0.0.0
API_PORT=8080

