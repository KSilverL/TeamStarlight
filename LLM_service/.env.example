# ── Feature toggle ────────────────────────────────────────────────────────────
# Master switch. true = mock everywhere (default, no real API calls).
# One-click production: set USE_MOCK=false and provide the credentials below.
USE_MOCK=true

# Optional per-service overrides for gradual rollout. Leave unset to inherit
# USE_MOCK. Resolution order: per-service var > USE_MOCK > default(true).
#   USE_MOCK_LLM     planner / outliner / copywriter / tone-critic / conversation (Azure OpenAI chat)
#   USE_MOCK_IMAGE   creator imagery (Azure OpenAI DALL-E)
#   USE_MOCK_SAFETY  content-safety stage of the critic (Azure AI Content Safety)
#   USE_MOCK_RAG     structure/tone retrieval + feedback store (Azure AI Search)
# Example — run LLM for real but keep everything else on mock:
# USE_MOCK=true
# USE_MOCK_LLM=false

# ── Azure OpenAI (chat + DALL-E + embeddings) — required when LLM/image/RAG ────
# RAG retrieval/write-back embeds text with AZURE_OPENAI_EMBEDDING_DEPLOYMENT, so
# the OpenAI creds below are also required when USE_MOCK_RAG=false.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DALLE_DEPLOYMENT=dall-e-3
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ── Azure AI Content Safety — required when USE_MOCK_SAFETY=false ──────────────
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# ── Azure AI Search (RAG vector store) — required when USE_MOCK_RAG=false ──────
# Two named collections in one Search service (RAG设计方案 §1):
#   outline_rag (Phase 1, "what to write") and content_rag (Phase 2, "how to write").
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_OUTLINE_INDEX=outline-rag
AZURE_SEARCH_CONTENT_INDEX=content-rag

# ── Backend status webhook ────────────────────────────────────────────────────
# The graph POSTs a per-node progress event (and per-platform result events) to
# WEBHOOK_URL. POSTing is on in production; set WEBHOOK_ENABLED=true to also POST
# while the rest of the stack is mocked (useful for developing the receiver).
WEBHOOK_URL=http://localhost:9999/status
# WEBHOOK_ENABLED=true
