{
  "name": "video_renderer",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion render service for the dynamic storyboard-driven brand video pipeline. Invoked as a CLI subprocess by LLM_service/workflow/video/render.py.",
  "scripts": {
    "render": "remotion render src/index.tsx StoryboardVideo",
    "studio": "remotion studio src/index.tsx",
