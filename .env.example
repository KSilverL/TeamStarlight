# Copy this file to .env and fill in the values before running docker compose.
# Docker Compose auto-substitutes ${VAR} references in docker-compose.yml from
# this file — everything below is read by the `llm` service.
#
#   cp .env.example .env
#   docker compose up --build

# ── Azure OpenAI / Foundry (chat + structured output) — required, not mocked ──
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# ── Web search (Bing grounding via Azure AI Foundry agents) — required, not mocked ──
# Leave FOUNDRY_PROJECT_ENDPOINT blank and set USE_MOCK_WEB_SEARCH=true in
# docker-compose.yml instead if you don't need live web search for the demo.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
WEB_SEARCH_AGENT_NAME=
WEB_SEARCH_AGENT_VERSION=
REVIEW_SEARCH_AGENT_NAME=
REVIEW_SEARCH_AGENT_VERSION=

# ── Postgres (brand profiles + user skills + workflow checkpoints + video jobs) ──
# Required, not mocked. POSTGRES_SSLMODE=require is mandatory for Azure Cosmos DB
# for PostgreSQL; leave blank for Supabase.
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_SSLMODE=

# ── Pexels (stock photos) + Remove.bg (cut-out backgrounds) — required, not mocked ──
PEXELS_API_KEY=
REMOVEBG_API_KEY=

# ── Roundtable (multi-persona discussion before drafting) — optional ────────────
# ROUNDTABLE_ENABLED=true swaps the strategist for a live persona debate on every
# POST /tasks run; see LLM_service/.env.example for what each knob does. Leave the
# rest blank to reuse AZURE_OPENAI_* above for the persona model too.
ROUNDTABLE_ENABLED=false
ROUNDTABLE_MAX_ROUNDS=12
ROUNDTABLE_PERSONA_MAX_TOKENS=1024
ROUNDTABLE_PERSONA_REASONING_EFFORT=minimal
ROUNDTABLE_PERSONA_VERBOSITY=low
ROUNDTABLE_MANAGER_MODEL=
ROUNDTABLE_PERSONA_MODEL=
ROUNDTABLE_CONTROL_TIMEOUT=300
AZURE_PERSONA_ENDPOINT=
AZURE_PERSONA_API_KEY=
TREND_SCOUT_ENABLED=false

# ── Video render backend — optional (defaults to Remotion) ────────────────────
# "local" (default) -> the Remotion CLI pipeline. "higgsfield" -> the premium
# generative-AI-video path instead (requires HIGGSFIELD_* below); see
# LLM_service/.env.example for the full explanation and the "lambda" option.
VIDEO_RENDER_BACKEND=local

# ── Remotion `generated`-slide codegen (video_renderer + LLM_service/workflow/video/codegen.py) — optional ──
# Deployment/tuning for the scene-codegen LLM calls; see LLM_service/.env.example
# for what each knob does. Blank CODEGEN_MODEL reuses AZURE_OPENAI_CHAT_DEPLOYMENT.
CODEGEN_MODEL=
CODEGEN_REASONING_EFFORT=high
CODEGEN_MAX_TOKENS=12000
CODEGEN_PLAN_MAX_TOKENS=1536
CODEGEN_PLAN_REASONING_EFFORT=minimal

# ── LinkedIn OAuth (Java backend) — required for LinkedIn connect/post ──────────
# Must exactly match the redirect URI registered on the LinkedIn Developer app.
LINKEDIN_REDIRECT_URI=http://localhost:8081/linkedin/callback
# Where the backend sends the browser after the LinkedIn OAuth round-trip.
FRONTEND_BASE_URL=http://localhost:3000

# ── Required by the brand-agent demo (LLM_service/demos/brand_agent), not the
# main docker-compose stack. Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
