# Copy this file to .env and fill in the values before running docker compose.
# Docker Compose auto-substitutes ${VAR} references in docker-compose.yml from
# this file — everything below is read by the `llm` service.
#
#   cp .env.example .env
#   docker compose up --build

# ── Azure OpenAI / Foundry (chat + structured output) — required, not mocked ──
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# ── Web search (Bing grounding via Azure AI Foundry agents) — required, not mocked ──
# Leave FOUNDRY_PROJECT_ENDPOINT blank and set USE_MOCK_WEB_SEARCH=true in
# docker-compose.yml instead if you don't need live web search for the demo.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
WEB_SEARCH_AGENT_NAME=
WEB_SEARCH_AGENT_VERSION=
REVIEW_SEARCH_AGENT_NAME=
REVIEW_SEARCH_AGENT_VERSION=

# ── Postgres (brand profiles + user skills + workflow checkpoints + video jobs) ──
# Required, not mocked. POSTGRES_SSLMODE=require is mandatory for Azure Cosmos DB
# for PostgreSQL; leave blank for Supabase.
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_SSLMODE=

# ── Pexels (stock photos) + Remove.bg (cut-out backgrounds) — required, not mocked ──
PEXELS_API_KEY=
REMOVEBG_API_KEY=

# ── Required by the brand-agent demo (LLM_service/demos/brand_agent), not the
# main docker-compose stack. Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
