# Copy this file to .env and fill in the values before running docker compose.
# Docker Compose auto-substitutes ${VAR} references in docker-compose.yml from
# this file — everything below is read by the `llm` service.
#
#   cp .env.example .env
#   docker compose up --build

# ── Azure OpenAI / Foundry (chat + structured output) — required, not mocked ──
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# ── Web search (Bing grounding via Azure AI Foundry agents) — required, not mocked ──
# Leave FOUNDRY_PROJECT_ENDPOINT blank and set USE_MOCK_WEB_SEARCH=true in
# docker-compose.yml instead if you don't need live web search for the demo.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
WEB_SEARCH_AGENT_NAME=
WEB_SEARCH_AGENT_VERSION=
REVIEW_SEARCH_AGENT_NAME=
REVIEW_SEARCH_AGENT_VERSION=

# ── Azure AI Content Safety (the reviewer node) ─────────────────────────────────
# A SEPARATE resource from AZURE_OPENAI_* above — the OpenAI key does not work here.
# Leave both blank and set USE_MOCK_SAFETY=true, or provision the resource and set
# USE_MOCK_SAFETY=false. A blank pair with USE_MOCK_SAFETY=false fails every run at
# the reviewer, so no draft ever reaches the human gate.
USE_MOCK_SAFETY=true
AZURE_CONTENTSAFETY_ENDPOINT=
AZURE_CONTENTSAFETY_KEY=

# ── Postgres (brand profiles + user skills + workflow checkpoints + video jobs) ──
# Required, not mocked. POSTGRES_SSLMODE=require is mandatory for Azure Cosmos DB
# for PostgreSQL; leave blank for Supabase.
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_SSLMODE=

# ── Pexels (stock photos) + Remove.bg (cut-out backgrounds) — required, not mocked ──
# Serves both Pexels endpoints: /v1/search (photos) and /videos/search (clips).
PEXELS_API_KEY=
REMOVEBG_API_KEY=

# ── Backing music (Jamendo) — optional ──────────────────────────────────────────
# Free client id from devportal.jamendo.com. Without it the bundled single-track
# library is used instead, so every video gets the same music regardless of mood.
# The free tier is non-commercial (Creative Commons catalogue).
JAMENDO_CLIENT_ID=
USE_MOCK_MUSIC_GENERATION=false

# ── Roundtable (multi-persona discussion before drafting) — optional ────────────
# ROUNDTABLE_ENABLED=true swaps the strategist for a live persona debate on every
# POST /tasks run; see LLM_service/.env.example for what each knob does. Leave the
# rest blank to reuse AZURE_OPENAI_* above for the persona model too.
ROUNDTABLE_ENABLED=false
ROUNDTABLE_MAX_ROUNDS=12
ROUNDTABLE_PERSONA_MAX_TOKENS=1024
ROUNDTABLE_PERSONA_REASONING_EFFORT=minimal
ROUNDTABLE_PERSONA_VERBOSITY=low
ROUNDTABLE_MANAGER_MODEL=
ROUNDTABLE_MANAGER_REASONING_EFFORT=   # blank → "low" (project default); minimal/medium/high to override
ROUNDTABLE_PERSONA_MODEL=
ROUNDTABLE_CONTROL_TIMEOUT=300
AZURE_PERSONA_ENDPOINT=
AZURE_PERSONA_API_KEY=
TREND_SCOUT_ENABLED=false

# ── Video render backend — optional (defaults to Remotion) ────────────────────
# "local" (default) -> the Remotion CLI pipeline. "higgsfield" -> the premium
# generative-AI-video path instead (requires HIGGSFIELD_* below); see
# LLM_service/.env.example for the full explanation and the "lambda" option.
VIDEO_RENDER_BACKEND=local

# ── Remotion `generated`-slide codegen (video_renderer + LLM_service/workflow/video/codegen.py) — optional ──
# Deployment/tuning for the scene-codegen LLM calls; see LLM_service/.env.example
# for what each knob does. Blank CODEGEN_MODEL reuses AZURE_OPENAI_CHAT_DEPLOYMENT.
CODEGEN_MODEL=
# "low" is the starting point, not the ceiling: this call is the single biggest
# contributor to render wall clock, and medium/high only pay for themselves if they
# actually cut retries. codegen.py logs per-stage `generate_s`/`attempt_s` timings on
# every attempt — compare those and the retry count before spending more here.
CODEGEN_REASONING_EFFORT=low
CODEGEN_MAX_TOKENS=12000
# Wall-clock ceiling for the WHOLE codegen pass of one render (a floor, scaled up per
# bespoke slide). Attempts alone don't bound duration once reasoning is on. 0 = off.
CODEGEN_MAX_TOTAL_SECONDS=900
CODEGEN_PLAN_MAX_TOKENS=1536
CODEGEN_PLAN_REASONING_EFFORT=minimal
# Keep at 0 — the openai SDK retries timeouts, so a retry on a 300s reasoning call
# multiplies the render's wall clock instead of saving it.
CODEGEN_MAX_RETRIES=0
CODEGEN_REVIEW_MAX_TOKENS=4096
CODEGEN_CONVERT_MAX_TOKENS=4096
CODEGEN_CONVERT_REASONING_EFFORT=minimal

# ── Java backend database — REQUIRED, the stack refuses to start without it ─────
# JDBC form (note `jdbc:` prefix and `?sslmode=require`) — NOT the postgresql:// URL
# the LLM service takes in DATABASE_URL above. Both must name the SAME database:
# ids issued by the backend are the ids the LLM service stores brand profiles under.
DB_URL=jdbc:postgresql://<host>:5432/<dbname>?sslmode=require
DB_USERNAME=
DB_PASSWORD=

# ── Outbound mail (Java backend) — optional ─────────────────────────────────────
# Notifies users when a scheduled post was missed. For Gmail this is an App Password,
# not the account password. Blank = notifications silently unsent.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── Instagram publishing (Java backend) — optional ──────────────────────────────
# Videos are staged in Azure Blob Storage and handed to Instagram as a short-lived SAS
# URL, so the storage connection string is required whenever Instagram posting is used.
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCOUNT_TOKEN=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=instagramcontent

# ── LinkedIn OAuth (Java backend) — required for LinkedIn connect/post ──────────
# Must exactly match the redirect URI registered on the LinkedIn Developer app.
LINKEDIN_REDIRECT_URI=http://localhost:8081/linkedin/callback
# ── Meta / Facebook OAuth (Java backend) — required for Facebook connect/post ───
# Must exactly match a Valid OAuth Redirect URI on the Meta app.
META_REDIRECT_URI=http://localhost:8081/meta/callback
# Where the backend sends the browser after an OAuth round-trip (must be browser-
# reachable — NOT 0.0.0.0, which is a bind address, not a navigable host).
FRONTEND_BASE_URL=http://localhost:3000

# ── Required by the brand-agent demo (LLM_service/demos/brand_agent), not the
# main docker-compose stack. Obtain from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
