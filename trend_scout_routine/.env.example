# Trend Scout routine — WRITE side env (docs/TREND_SCOUT_IMPLEMENTATION.md §5).
# run_scan.py loads this file first, then falls back to ../LLM_service/.env for anything
# unset (dev convenience — locally the two sides may share a DSN, never a process).

# ── Foundry agent (portal-defined, called by agent_reference) ──────────────────
# The agent lives in the Foundry portal: its Instructions are the output of
# `run_scan.py --print-instructions` (prompt.md with MARKET/LANGUAGE filled), with the
# web grounding tool (Grounding with Bing Search) attached, published as a version.
# The script references it through the project's OpenAI responses API
# (`extra_body={"agent_reference": {name, version}}`; azure-ai-projects>=2.1.0).
#
# The Azure AI Foundry project endpoint (https://<resource>.services.ai.azure.com/api/projects/<project>).
FOUNDRY_PROJECT_ENDPOINT=
# The portal agent's name + version (version optional — unset lets the service resolve it).
TREND_AGENT_NAME=
TREND_AGENT_VERSION=

# ── Scan shaping ───────────────────────────────────────────────────────────────
# Substituted into prompt.md's {MARKET} / {LANGUAGE} before the run. Match the market the
# posts target (a Chinese-market deployment should search 微博/抖音/小红书-style sources
# and write Chinese text).
TREND_MARKET=global, English-language
TREND_LANGUAGE=English
# expires_at stamped on every trend = now + this many days (the read side also has its own
# TREND_SCOUT_TTL_DAYS fallback for docs missing expires_at; keep the two aligned).
TREND_TTL_DAYS=3

# ── Database (the ONLY contact surface with the LLM service) ───────────────────
# Least-privilege DSN for the routine (role from role.sql — INSERT/UPDATE/SELECT on the
# trends table only). Falls back to DATABASE_URL (dev). Azure Cosmos DB for PostgreSQL
# requires TLS → keep POSTGRES_SSLMODE=require there (unset for Supabase).
TRENDS_DATABASE_URL=
POSTGRES_SSLMODE=require
POSTGRES_TRENDS_TABLE=trends
