package com.example.tsldemo.DTOs.Response;

import jakarta.persistence.Entity;

@Entity
public class IntakeRespDTO {

    @JsonProperty("intake_mode")
	private String intakeMode;

    @JsonProperty("session_id")
	private String sessionId;

    @JsonProperty("assistant_message")
    private String assistantMessage;

    // @JsonProperty("brief_partial")
    // private String brief_partial;

    @JsonProperty("complete")
    private Boolean complete;

    
    public IntakeRespDTO(String intake_mode, String session_id, String assistant_message, Boolean complete) {
		this.intakeMode = intake_mode;
		this.sessionId = session_id;
		this.assistantMessage = assistant_message;
		this.complete = complete;
	}
}
